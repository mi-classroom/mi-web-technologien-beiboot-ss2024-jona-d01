{
  "openapi": "3.0.0",
  "info": {
    "title": "Frame Magic 🪄 – API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/upload": {
      "post": {
        "summary": "Upload video file",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "video": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully uploaded the video"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Video"]
      }
    },
    "/frames": {
      "post": {
        "summary": "Extract frames from the uploaded video",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "frameRate": {
                    "type": "integer",
                    "description": "Frames per second",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "resolution": {
                    "type": "string",
                    "description": "Resolution of the frames"
                  }
                },
                "required": ["frameRate", "resolution"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created Frames successfully."
          },
          "400": {
            "description": "Invalid input parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Frames"]
      }
    },
    "/thumbnails": {
      "post": {
        "summary": "Extract thumbnails from the uploaded video",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "frameRate": {
                    "type": "integer",
                    "description": "Frames per second",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": ["frameRate"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully created thumbnails."
          },
          "400": {
            "description": "Invalid input parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Thumbnails"]
      },
      "get": {
        "summary": "Get all thumbnails",
        "responses": {
          "200": {
            "description": "List of thumbnails",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "selected": {
                        "type": "boolean"
                      },
                      "showPreviewIcon": {
                        "type": "boolean"
                      },
                      "showSkeleton": {
                        "type": "boolean"
                      },
                      "opacity": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Thumbnails"]
      }
    },
    "/filterImages": {
      "put": {
        "summary": "Filter images and delete unselected ones",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "selected": {
                          "type": "boolean"
                        },
                        "showPreviewIcon": {
                          "type": "boolean"
                        },
                        "showSkeleton": {
                          "type": "boolean"
                        },
                        "opacity": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Filtered images successfully."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["All images"]
      }
    },
    "/output": {
      "post": {
        "summary": "Create output image from frames",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "selected": {
                          "type": "boolean"
                        },
                        "showPreviewIcon": {
                          "type": "boolean"
                        },
                        "showSkeleton": {
                          "type": "boolean"
                        },
                        "opacity": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created picture successfully."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Output"]
      },
      "get": {
        "summary": "Get the output image",
        "responses": {
          "200": {
            "description": "Base64 encoded image",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA..."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Output"]
      }
    },
    "/trimVideo": {
      "post": {
        "summary": "Trim the uploaded video",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "startTime": {
                    "type": "number",
                    "description": "Start time in seconds"
                  },
                  "endTime": {
                    "type": "number",
                    "description": "End time in seconds"
                  }
                },
                "required": ["startTime", "endTime"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Video trimmed successfully."
          },
          "400": {
            "description": "Invalid startTime or endTime"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Video"]
      }
    }
  }
}